# Copy to /etc/systemd/system/odysseus-ui.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=Odysseus UI
After=network.target

[Service]
Type=simple
User=frieso
WorkingDirectory=/home/frieso/odysseus
ExecStart=/home/frieso/odysseus/venv/bin/uvicorn app:app --port 24950 --host 127.0.0.1
Environment=APP_PORT=24950
Restart=always
RestartSec=3
EnvironmentFile=-/home/frieso/odysseus/.env

[Install]
WantedBy=multi-user.target
