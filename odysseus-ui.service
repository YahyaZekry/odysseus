# Copy to /etc/systemd/system/odysseus-ui.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=Odysseus UI
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your user and install path:
User=YOURUSER
WorkingDirectory=/home/YOURUSER/odysseus
ExecStart=/home/YOURUSER/odysseus/venv/bin/uvicorn app:app --port 24950 --host 127.0.0.1
Environment=APP_PORT=24950
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/odysseus/.env

[Install]
WantedBy=multi-user.target
